# Pooled PostgreSQL connection used by the Next.js runtime and Prisma adapter.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Direct PostgreSQL connection used by Prisma CLI schema operations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional: set to "false" only when connecting to a local PostgreSQL server without SSL.
DATABASE_SSL="true"
